<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.portty.spike.helper</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/spike-helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>spike-helper</string>
		<string>agent</string>
		<string>--config</string>
		<string>/tmp/spike-evidence/agent-A.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/spike-helper.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/spike-helper.log</string>
</dict>
</plist>
