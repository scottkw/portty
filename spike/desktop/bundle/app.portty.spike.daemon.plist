<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Disabled</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>app.portty.spike.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>__EXE__</string>
		<string>agent</string>
		<string>--config</string>
		<string>/tmp/spike-evidence/agent-B.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>SessionCreate</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/spike-daemon.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/spike-daemon.log</string>
</dict>
</plist>
